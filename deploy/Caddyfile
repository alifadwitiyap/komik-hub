{
	admin off
}

# Listener publik = $PORT dari Railway (fallback 8080 untuk docker run lokal).
# TLS tidak di sini: Railway mengakhiri HTTPS di edge-nya (domain *.up.railway.app).
:{$PORT:8080} {
	# Healthcheck Railway (TANPA auth): diteruskan ke /api/health axum supaya
	# "healthy" berarti backend benar-benar hidup, bukan sekadar Caddy berdiri.
	@health path /healthz
	handle @health {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:8788
	}

	# Semua request lain: basic auth, lalu proxy ke backend Rust.
	# BASIC_AUTH_HASH kosong -> config gagal parse -> container exit (fail-closed,
	# sengaja: jangan pernah tayang tanpa auth).
	handle {
		basic_auth {
			{$BASIC_AUTH_USER:alif} {$BASIC_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:8788
	}
}
