{
	admin off
}

# SITE_ADDR menentukan mode:
#   - ":8080" / ":<PORT>" (Railway/Render) -> HTTP polos, TLS di edge platform.
#   - hostname, mis. "1.2.3.4.sslip.io" (VM Oracle) -> Caddy auto-HTTPS:
#     bind 443 + Let's Encrypt otomatis + redirect 80->443.
# entrypoint.sh mengisi default ":${PORT:-8080}" bila SITE_ADDR kosong.
{$SITE_ADDR::8080} {
	# Healthcheck TANPA auth: diteruskan ke /api/health axum supaya
	# "healthy" berarti backend benar-benar hidup, bukan sekadar Caddy berdiri.
	@health path /healthz
	handle @health {
		rewrite * /api/health
		reverse_proxy 127.0.0.1:8788
	}

	# Semua request lain: basic auth, lalu proxy ke backend Rust.
	# BASIC_AUTH_HASH kosong -> config gagal parse -> container exit (fail-closed,
	# sengaja: jangan pernah tayang tanpa auth).
	handle {
		basic_auth {
			{$BASIC_AUTH_USER:alif} {$BASIC_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:8788
	}
}
